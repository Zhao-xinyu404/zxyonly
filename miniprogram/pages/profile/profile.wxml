<!-- pages/profile/profile.wxml -->
<view class="profile-page" wx:if="{{user}}">
  <view class="header">
    <view class="avatar">{{(user.nickname || user.username)[0]}}</view>
    <view class="user-info">
      <view class="nickname">{{user.nickname || user.username}}</view>
      <view class="username text-muted">无聊号: {{user.username}}</view>
    </view>
  </view>

  <view class="menu">
    <view class="menu-item">
      <text>邮箱</text>
      <text class="text-muted">{{user.email || '未设置'}}</text>
    </view>
    <view class="menu-item">
      <text>个性签名</text>
      <text class="text-muted">{{user.bio || '这个人很懒'}}</text>
    </view>
    <view class="menu-item">
      <text>注册时间</text>
      <text class="text-muted">{{user.createdAt ? user.createdAt : '未知'}}</text>
    </view>
  </view>

  <!-- APP 下载入口 -->
  <view class="menu">
    <view class="menu-item menu-item--link" bindtap="onDownloadApp">
      <view class="app-download">
        <text class="app-download__title">下载无聊Chat APP</text>
        <text class="app-download__sub text-muted">Android 安装包 · 蓝奏云</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item menu-item--link" bindtap="onCopyDownloadAll">
      <text>复制完整下载信息</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="logout-btn" bindtap="onLogout">退出登录</view>
</view>
