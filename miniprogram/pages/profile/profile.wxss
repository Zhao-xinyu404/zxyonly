/* pages/profile/profile.wxss */
.profile-page {
  min-height: 100vh;
}

.header {
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: #07c160;
  color: #fff;
  font-size: 52rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-info {
  margin-left: 28rpx;
}

.nickname {
  font-size: 38rpx;
  font-weight: 600;
  color: #333;
}

.username {
  margin-top: 8rpx;
}

.menu {
  background: #fff;
  margin-bottom: 40rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 30rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.logout-btn {
  margin: 0 30rpx;
  text-align: center;
  padding: 28rpx 0;
  background: #fff;
  border-radius: 16rpx;
  color: #f5450c;
  font-size: 32rpx;
}

.logout-btn:active {
  opacity: 0.7;
}

/* APP 下载入口 */
.menu-item--link {
  cursor: pointer;
}

.menu-item--link:active {
  background: #f7f7f7;
}

.app-download {
  display: flex;
  flex-direction: column;
}

.app-download__title {
  font-size: 30rpx;
  color: #07c160;
}

.app-download__sub {
  font-size: 24rpx;
  margin-top: 6rpx;
}

.arrow {
  color: #c8c8c8;
  font-size: 40rpx;
  line-height: 1;
}
