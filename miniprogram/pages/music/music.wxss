/* pages/music/music.wxss */
.music-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 歌单标签 */
.playlist-tabs {
  white-space: nowrap;
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.tab {
  display: inline-block;
  margin-right: 20rpx;
  vertical-align: top;
}

.tab-cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.6;
}

.tab.active .tab-cover {
  opacity: 1;
  transform: scale(1.05);
  transition: all 0.2s;
}

.tab-name {
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  padding: 0 16rpx;
}

/* 歌曲列表 */
.song-list {
  flex: 1;
  overflow-y: auto;
  padding-bottom: 140rpx;
}

.song-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #f5f5f5;
}

.song-item:active {
  background: #f9f9f9;
}

.song-item.playing {
  background: #f0fbf4;
}

.song-index {
  width: 60rpx;
  text-align: center;
  font-size: 30rpx;
  color: #999;
}

.playing-icon {
  color: #07c160;
  font-size: 36rpx;
}

.song-info {
  flex: 1;
  margin-left: 16rpx;
  overflow: hidden;
}

.song-title {
  font-size: 32rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.song-item.playing .song-title {
  color: #07c160;
}

.song-artist {
  margin-top: 6rpx;
  font-size: 24rpx;
}

.song-duration {
  font-size: 24rpx;
}

/* 底部播放控制条 */
.player-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #e0e0e0;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.player-info {
  flex: 1;
  overflow: hidden;
}

.player-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.player-artist {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.player-controls {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.ctrl-btn {
  font-size: 24rpx;
  color: #333;
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
}

.ctrl-btn:active {
  opacity: 0.7;
}

.play-btn {
  background: #07c160;
  color: #fff;
  padding: 12rpx 32rpx;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
}
