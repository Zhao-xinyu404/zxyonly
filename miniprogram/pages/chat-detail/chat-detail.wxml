<!-- pages/chat-detail/chat-detail.wxml -->
<view class="chat-detail">
  <scroll-view class="msg-list" scroll-y scroll-into-view="{{scrollToView}}" scroll-with-animation>
    <view class="msg-item {{item.isMe ? 'me' : 'other'}}" wx:for="{{messages}}" wx:key="index" id="msg-{{index}}">
      <view class="bubble">
        <text>{{item.content}}</text>
      </view>
      <view class="time text-muted">{{item.timeText}}</view>
    </view>
    <view class="empty text-muted" wx:if="{{!loading && messages.length === 0}}">
      还没有消息，发一条吧
    </view>
  </scroll-view>

  <view class="input-bar">
    <input class="msg-input" placeholder="发消息..." value="{{inputText}}" bindinput="onInput" confirm-type="send" bindconfirm="onSend" />
    <view class="send-btn" bindtap="onSend">发送</view>
  </view>
</view>
