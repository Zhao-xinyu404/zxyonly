/* pages/chat-list/chat-list.wxss */
.chat-list {
  padding: 0;
}

.chat-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #ededed;
}

.chat-item:active {
  background: #f5f5f5;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  color: #fff;
  font-size: 38rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.info {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}

.name {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.bio {
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.badge {
  background: #f5450c;
  color: #fff;
  font-size: 22rpx;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.empty {
  padding: 200rpx 0;
  text-align: center;
}
