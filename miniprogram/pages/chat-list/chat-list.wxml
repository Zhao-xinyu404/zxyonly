<!-- pages/chat-list/chat-list.wxml -->
<view class="chat-list">
  <block wx:if="{{friends.length > 0}}">
    <view class="chat-item" wx:for="{{friends}}" wx:key="username"
          data-username="{{item.username}}" data-nickname="{{item.nickname}}"
          bindtap="onTapFriend">
      <view class="avatar" style="background: {{item.avatarBg}}">
        {{item.avatarText}}
      </view>
      <view class="info">
        <view class="name">{{item.displayName}}</view>
        <view class="bio text-muted">{{item.displayBio}}</view>
      </view>
      <view class="badge" wx:if="{{item.unreadCount > 0}}">
        {{item.unreadCount}}
      </view>
    </view>
  </block>

  <view class="empty" wx:if="{{!loading && friends.length === 0}}">
    <text class="text-muted">还没有好友，去网页版添加好友吧</text>
  </view>
</view>
