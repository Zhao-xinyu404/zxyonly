/* app.wxss - 全局样式 */
page {
  background-color: #ededed;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

/* 常用容器 */
.container {
  padding: 20rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

/* 按钮 */
.btn-primary {
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-primary:active {
  opacity: 0.85;
}

/* 输入框 */
.input {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 24rpx 20rpx;
  font-size: 30rpx;
  margin-bottom: 20rpx;
}

/* 文字辅助 */
.text-muted {
  color: #999;
  font-size: 24rpx;
}

.text-center {
  text-align: center;
}

/* flex 工具 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}
